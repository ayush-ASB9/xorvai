#!/usr/bin/env bash
# Prepares a fresh Amp orb. The app has no npm dependencies; this checks the toolchain and
# installs anything package-lock.json adds later.
set -euo pipefail
cd "$(dirname "$0")/.."

step() {
  local start=$SECONDS
  echo "==> $*"
  "$@"
  echo "    done in $((SECONDS - start))s"
}

step node --version
# npm install reuses node_modules restored from a stale snapshot; npm ci would delete and redownload it.
step npm install --no-audit --no-fund --prefer-offline
