{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xorvai",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "XORVAI_USERS",
      "id": "xorvai-users-dev"
    }
  ]
}
